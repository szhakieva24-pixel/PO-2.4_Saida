<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="schoolapp.MainPage">

    <VerticalStackLayout
        Padding="30"
        Spacing="25"
        VerticalOptions="Center">

        <Label
            Text="School App"
            FontSize="32"
            HorizontalOptions="Center" />

        <Label
            Text="Powered by .NET 10 MAUI"
            FontSize="18"
            HorizontalOptions="Center" />

        <Label
            x:Name="StatusLabel"
            Text="Checks: 0"
            FontSize="20"
            HorizontalOptions="Center" />

        <Button
            Text="Check"
            Clicked="OnCheckClicked"
            HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>